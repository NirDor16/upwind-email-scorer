# Copy this file to `.env` for local development and fill in real values.
# NEVER commit the real .env file — it is git-ignored on purpose.

# Port the server listens on locally (Render sets its own PORT automatically).
PORT=3000

# Shared secret between the Gmail Add-on and this backend.
# Use a long random string. The same value must be set in the add-on's
# Script Properties (SHARED_SECRET).
SHARED_SECRET=change-me-to-a-long-random-string

# OpenAI API key — used only by the explanation layer (added in M4).
# Leave empty for now.
OPENAI_API_KEY=
